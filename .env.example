# Google Cloud Configuration
PROJECT_ID=seu-projeto-rag
LOCATION=us-central1
REGION=us-central1

# Cloud Storage
BUCKET_NAME=seu-projeto-rag-data
RAW_DATA_PATH=raw_data/flipkart_products.csv
EMBEDDINGS_PATH=embeddings/
PROCESSED_DATA_PATH=processed_data/

# Vector Search Configuration
VECTOR_SEARCH_INDEX_NAME=produtos-index
VECTOR_SEARCH_ENDPOINT_NAME=produtos-endpoint
VECTOR_DIMENSIONS=768
VECTOR_DISTANCE_MEASURE=DOT_PRODUCT_DISTANCE

# Embedding Model Configuration
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
EMBEDDING_BATCH_SIZE=250

# LLM Configuration
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TOP_P=0.8
LLM_TOP_K=40

# RAG Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Kaggle Configuration (opcional - para download automático)
KAGGLE_USERNAME=seu-usuario-kaggle
KAGGLE_KEY=sua-chave-api-kaggle

# Deployment Configuration
SERVICE_ACCOUNT_EMAIL=demo-rag-sa@seu-projeto-rag.iam.gserviceaccount.com
ENDPOINT_MACHINE_TYPE=n1-standard-4
MIN_REPLICA_COUNT=1
MAX_REPLICA_COUNT=3

# Logging
LOG_LEVEL=INFO
